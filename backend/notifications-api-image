FROM golang:1.22-alpine

WORKDIR /app

COPY ./commons ./commons
WORKDIR /app/commons
RUN go mod tidy

WORKDIR /app

COPY ./read-server ./read-server
WORKDIR /app/read-server
RUN go mod tidy

RUN CGO_ENABLED=0 go build -o /app/notifications-api
WORKDIR /app
RUN rm -rf ./commons ./read-server
EXPOSE 8080

CMD ["./notifications-api",  "/etc/api/config.yaml"]

