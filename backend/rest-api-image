FROM golang:1.22-alpine

WORKDIR /app

COPY ./commons ./commons
WORKDIR /app/commons
RUN go mod tidy

WORKDIR /app

COPY ./write-server ./write-server
WORKDIR /app/write-server
RUN go mod tidy

RUN CGO_ENABLED=0 go build -o /app/rest-api
WORKDIR /app
RUN rm -rf ./commons ./write-server

EXPOSE 8080

CMD ["./rest-api", "/etc/api/config.yaml"]
